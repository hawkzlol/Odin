{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["Odtheking"],
  "contributors": ["hawkzlol (Minecraft 26.2 port)"],
  "contact": {
    "homepage": "https://github.com/hawkzlol/Odin/tree/mc-26.2",
    "sources": "https://github.com/hawkzlol/Odin/tree/mc-26.2",
    "issues": "https://github.com/hawkzlol/Odin/issues"
  },
  "icon": "assets/odin/icon.png",
  "license": "BSD 3-Clause",
  "environment": "client",
  "entrypoints": {
    "modmenu": [
      "com.odtheking.odin.clickgui.ModMenuIntegration"
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "com.odtheking.odin.OdinMod"
      }
    ]
  },
  "mixins": [
    "odin.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "${minecraft_version_range}",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}",
    "java": ">=25"
  },
  "custom": {
    "modmenu": {
      "update_checker": false
    }
  },
  "accessWidener": "odin.accesswidener"
}
